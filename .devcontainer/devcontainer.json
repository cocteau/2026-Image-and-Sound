{
  "name": "Data course",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && pip install -e .",
  "secrets": {
    "OPENROUTER_API_KEY": {
      "description": "Your personal course key (from your instructor). Paste it once; it stays private to your codespace."
    }
  },
  "containerEnv": {
    "ASK_BASE_URL": "https://openrouter.ai/api/v1",
    "ASK_MODEL": "deepseek/deepseek-chat"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["notebooks/01-is-this-number-right.ipynb"]
    },
    "vscode": {
      "extensions": ["ms-toolsai.jupyter", "ms-python.python"],
      "settings": {
        "workbench.startupEditor": "none",
        "editor.minimap.enabled": false,
        "workbench.tips.enabled": false
      }
    }
  }
}
