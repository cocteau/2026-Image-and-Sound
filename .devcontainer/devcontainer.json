{
  "name": "2026 Image and Sound",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "onCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-jupyter.sh",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab" }
  }
}
