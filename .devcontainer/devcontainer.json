{
  "name": "2026 Image and Sound",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "onCreateCommand": "pip install -r requirements.txt && npm install -g @anthropic-ai/claude-code @agentclientprotocol/claude-agent-acp",
  "postStartCommand": "bash .devcontainer/start-jupyter.sh",
  "forwardPorts": [
    8888
  ],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "openBrowser"
    },
    "3001": {
      "label": "Jupyter AI (internal)",
      "onAutoForward": "ignore"
    }
  },
  "secrets": {
    "OPENROUTER_API_KEY": {
      "description": "Your OpenRouter key (starts with sk-or-). Jupyter AI uses it to reach Claude."
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  }
}
