{
  "name": "Image and Sound",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "onCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup jupyter lab --no-browser --ip=0.0.0.0 --port=8899 --ServerApp.port_retries=0 --ServerApp.token='' --ServerApp.password='' --ServerApp.allow_origin='*' --ServerApp.root_dir=${containerWorkspaceFolder} > /tmp/jupyterlab.log 2>&1 &",
  "forwardPorts": [8899],
  "portsAttributes": {
    "8899": {
      "label": "JupyterLab",
      "onAutoForward": "openBrowser"
    }
  }
}
