{
  "name": "Data course",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && pip install -e .",
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "A Claude API key (instructor setup). Leave blank if you were given a course key below."
    },
    "OPENROUTER_API_KEY": {
      "description": "Your personal course key from your instructor. Leave blank if you entered a Claude API key above."
    }
  },
  "containerEnv": {
    "ASK_BASE_URL": "https://openrouter.ai/api/v1"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["notebooks/01-is-this-number-right.ipynb"]
    },
    "vscode": {
      "extensions": ["ms-toolsai.jupyter", "ms-python.python"],
      "settings": {
        "workbench.startupEditor": "none",
        "editor.minimap.enabled": false,
        "workbench.tips.enabled": false
      }
    }
  }
}
